.user-card {
  text-align: center;
  margin-bottom: 18rpx;
}

.avatar {
  font-size: 88rpx;
}

.name {
  margin-top: 6rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.grid-item {
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx 12rpx;
  text-align: center;
}

.value {
  font-size: 34rpx;
  color: #0a3d62;
  font-weight: 700;
}

.label {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 22rpx;
}
